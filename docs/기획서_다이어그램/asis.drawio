<mxfile><diagram name="As-Is"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t11" value="As-Is: 담당자별 현재 업무 (붉은 칸 = 고충)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="935" height="36" as="geometry"/></mxCell><mxCell id="lane0" value="신청자(단체)" style="swimlane;horizontal=0;startSize=90;fontSize=14;fontStyle=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="935" height="140" as="geometry"/></mxCell><mxCell id="lane1" value="오 주무관" style="swimlane;horizontal=0;startSize=90;fontSize=14;fontStyle=1;fillColor=#F6F9FF;strokeColor=#D5DAE1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="190" width="935" height="140" as="geometry"/></mxCell><mxCell id="lane2" value="시설 직원" style="swimlane;horizontal=0;startSize=90;fontSize=14;fontStyle=1;fillColor=#FFF7F2;strokeColor=#D5DAE1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="330" width="935" height="140" as="geometry"/></mxCell><mxCell id="lane3" value="팀장" style="swimlane;horizontal=0;startSize=90;fontSize=14;fontStyle=1;fillColor=#F3FAF5;strokeColor=#D5DAE1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="470" width="935" height="140" as="geometry"/></mxCell><mxCell id="A1" value="게시판에 신청 글 (1일 9시, 약 50건)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1B1F24;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="lane0"><mxGeometry x="100" y="34" width="120" height="72" as="geometry"/></mxCell><mxCell id="A2" value="결과·규정 문의 전화 (하루 30통)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="lane0"><mxGeometry x="660" y="34" width="120" height="72" as="geometry"/></mxCell><mxCell id="B1" value="게시판 순서대로 엑셀에 옮김" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="lane1"><mxGeometry x="240